# ==========================================
# BookBuddy AI - Backend Environment Config
# ==========================================

# Your Google Gemini API Key from Google AI Studio:
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model to use (supported models: gemini-3.1-flash-lite, gemini-3.8-flash, gemini-flash-latest)
GEMINI_MODEL=gemini-3.1-flash-lite

# Port for Express server (default: 5000)
PORT=5000

# Frontend origin allowed for CORS (default: http://localhost:5173)
CLIENT_ORIGIN=http://localhost:5173
